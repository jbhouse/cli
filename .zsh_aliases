#!/bin/bash

# For a full list of active aliases, run `alias`.
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

# For a full list of active aliases, run `alias`.
alias update="$UPDATE"
alias fresh="$FRESH"

alias pwdc="pwd | $CLIPBOARD"

# git aliases
alias gs="git status"
alias gas="gitAddStash"
alias gaso="git stash apply 0"
alias gpo="git pull origin"
# this will unstage the last commit
alias gu="git reset --soft HEAD~1"
#alias gb="git branch --show-current"
# alias branches="git branch -r | sed \"s|origin/||\" | fzf"
# alias branch="git branch --show-current"
alias gac="gitAddCommit"
alias gacp="gitAddCommitPush"
alias gsh="gitSwitchHead"
alias gsb="gitSwitchBranch"
alias gsa="gitStashApply"
alias gsd="gitStashDelete"
# alias gcob="gitSwitchBranch"
alias gpoh="gitPullOriginHead"
alias clone="git clone"
alias gsl="git stash list"

alias cli="cd ~/Documents/cli"
alias repos="cd ~/repos"
alias temp="cd ~/temp"

alias tls="tmux ls"
alias tka="tmux kill-server"

# alias kubectl="k3s kubectl"

alias la='ls -A'
alias c='clear'
alias h='history'
alias home='cd ~'
alias ex="/mnt/c/Windows/explorer.exe"
# add this to zsh env
alias ll='ls -alF'
alias l='ls -CF'
alias lsg='ls | grep'
