#!/bin/bash

function allLogsFor() {
  pane=0
  window=0
  for pod in $(podsList $1); do
    if [ $pane -eq 0 ]; then tmux new-session -d -s $1;
      else
        n=$(($pane%5))
        if [ $n -eq 0 ];
          then
            ((window++));
            pane=0;
            tmux new-window -t $1:$window;
          else
            tmux split-window -h;
        fi
    fi
    tmux send-keys -t $1:$window.$pane "kubectl -n $KNS --kubeconfig=$KUBECONFIG logs -f $pod" C-m;
    ((pane++))
  done
  tmux select-layout -t $1:0 tiled
  tmux attach -t $1
}

function hlm() { cube-configure; helm -n $KNS --kubeconfig=$KUBECONFIG --kube-context=$CONTEXT $* ;}

function podsList() {
  if [ ! -z "$1" ]
    then cube get po | awk '{ print $1 }' | grep $1
    else cube get po | awk '{ print $1 }'
  fi
}

function podDescribe() {
  if [ ! -z "$1" ]
    then cube describe po $1;
    else cube describe po $(podGet);
  fi
}

function podDelete() {
  if [ ! -z "$1" ]
    then cube delete po $1;
    else cube delete po $(podGet);
  fi
}

function podExec() { cube exec $(podGet) -- $* ;}

function podTerminal() {
  if [ ! -z "$1" ]
    then cube exec "$1" -it -- /bin/bash
    else cube exec $(podGet) -it -- /bin/bash
  fi
}

function podGet() { cube get po | awk '{ print $1 }' | fzf ;}

function cube-configure() { if [ -z $KNS ] || [ -z $KUBECONFIG ] || [ -z $CONTEXT ]; then cubeSetEnv ; fi ; }

function cube() {
  cube-configure;
  kubectl -n $KNS --kubeconfig=$KUBECONFIG --context=$CONTEXT $*;
}

function cubeUpdateConfig() {
  KUBECONFIG=~/.kube/$(ls ~/.kube | fzf)
}

function cubeUpdateContext() {
  CONTEXT=$(kubectl --kubeconfig=$KUBECONFIG config get-contexts | sed '1d' | awk '{print $2}' | fzf)
}

function cubeUpdateNamespace() {
  KNS=$(kubectl --kubeconfig=$KUBECONFIG --context=$CONTEXT get namespaces | awk '{print $1}' | fzf)
}

function cubeReadConfig() {
  KUBECONFIG=$(sed -n "s|^KUBECONFIG=||p" ~/.kube_env)
}

function cubeReadContext() {
  CONTEXT=$(sed -n "s|^CONTEXT=||p" ~/.kube_env)
}

function cubeReadNamespace() {
  KNS=$(sed -n "s|^KNS=||p" ~/.kube_env)
}

function readEnv() {
  cubeReadConfig
  cubeReadContext
  cubeReadNamespace
  # check if current context is different from context
  # kubectl --kubeconfig=$KUBECONFIG config set-context $CONTEXT
}

function cubeSetEnv() {
  cubeUpdateConfig
  cubeUpdateContext
  cubeUpdateNamespace
  # check if current context is different from context
  # kubectl --kubeconfig=$KUBECONFIG config set-context $CONTEXT 
}

function cubeUpdateEnv() {
  cubeSetEnv
  sed -i -e "s|KUBECONFIG=.*|KUBECONFIG=$KUBECONFIG|" -e "s|KNS=.*|KNS=$KNS|" -e "s|CONTEXT=.*|CONTEXT=$CONTEXT|" ~/.kube_env
}

function initEnv() {
  if [ ! -f ~/.kube_env ]
    then
      printf "KUBECONFIG=default\nKNS=default\nCONTEXT=default" > ~/.kube_env
      cubeUpdateEnv
    else
      readEnv
  fi
}

# tmux functions
function tss() { if [ $# -eq 0 ]; then tmux; else tmux new -s $*; fi ;}
function tas() { if [ $# -eq 0 ]; then tmux attach -t $(tmux ls | sed -n '/:/s/:.*//p' | fzf); else tmux attach -t $*; fi ;}
function tks() { tmux kill-session -t $(tmux ls | sed -n '/:/s/:.*//p' | fzf -m) ;}

# function hist() { num=$(history | grep $1 | fzf | sed -n 's/[0-9][0-9]*//p' | sed 's/^[[:space:]]*//g'); eval $num ;}
function hist() {
  if [ ! -z "$1" ]
    then num=$(history | sort -rn | grep $1 | fzf | sed -n 's/[0-9][0-9]*//p' | sed 's/^[[:space:]]*//g');
    else num=$(history | sort -rn | fzf | sed -n 's/[0-9][0-9]*//p' | sed 's/^[[:space:]]*//g');
  fi
  eval $num;
}

function cubeScale() {
  RESOURCE_TYPE=$(echo "statefulsets\ndeployments" | fzf)
  RESOURCE_NAME=$(cube get $RESOURCE_TYPE | fzf | awk '{ print $1 }')
  echo "Scaling deployment ${RESOURCE_NAME}"
  echo "How many replicas would you like to scale to?"
  read replicacount
  cube scale $RESOURCE_TYPE $RESOURCE_NAME --replicas=$replicacount
}

function cubeControl() {
  tmux new-session -d -s "cubeControl";
  tmux rename-window "pods";
  tmux send-keys -t "cubeControl":"pods" "KNS=$KNS;KUBECONFIG=$KUBECONFIG" C-m;
  tmux send-keys -t "cubeControl":"pods" "pods" C-m;

  tmux new-window -t "cubeControl":1;
  tmux rename-window "services";
  tmux send-keys -t "cubeControl":"services" "KNS=$KNS;KUBECONFIG=$KUBECONFIG" C-m;
  tmux send-keys -t "cubeControl":"services" "services" C-m;

  tmux new-window -t "cubeControl":2;
  tmux rename-window "deployments";
  tmux send-keys -t "cubeControl":"deployments" "KNS=$KNS;KUBECONFIG=$KUBECONFIG" C-m;
  tmux send-keys -t "cubeControl":"deployments" "deployments" C-m;

  tmux new-window -t "cubeControl":3;
  tmux rename-window "statefulsets";
  tmux send-keys -t "cubeControl":"statefulsets" "KNS=$KNS;KUBECONFIG=$KUBECONFIG" C-m;
  tmux send-keys -t "cubeControl":"statefulsets" "statefulsets" C-m;

  tmux new-window -t "cubeControl":4;
  tmux rename-window "replicasets";
  tmux send-keys -t "cubeControl":"replicasets" "KNS=$KNS;KUBECONFIG=$KUBECONFIG" C-m;
  tmux send-keys -t "cubeControl":"replicasets" "replicasets" C-m;

  tmux new-window -t "cubeControl":5;
  tmux rename-window "configmaps";
  tmux send-keys -t "cubeControl":"configmaps" "KNS=$KNS;KUBECONFIG=$KUBECONFIG" C-m;
  tmux send-keys -t "cubeControl":"configmaps" "configmaps" C-m;

  tmux new-window -t "cubeControl":6;
  tmux rename-window "secrets";
  tmux send-keys -t "cubeControl":"secrets" "KNS=$KNS;KUBECONFIG=$KUBECONFIG" C-m;
  tmux send-keys -t "cubeControl":"secrets" "secrets" C-m;

  tmux new-window -t "cubeControl":7;
  tmux rename-window "ingress";
  tmux send-keys -t "cubeControl":"ingress" "KNS=$KNS;KUBECONFIG=$KUBECONFIG" C-m;
  tmux send-keys -t "cubeControl":"ingress" "ingress" C-m;

  tmux attach -t "cubeControl";
}

function pods() {
  readEnv
  cube get po | fzf \
    --bind "ctrl-o:execute:${EDITOR:-vim} <(cube logs --all-containers {1}) > /dev/tty" \
    --bind "ctrl-d:execute:cube delete pod {1}" \
    --bind "ctrl-r:reload:cube get po" \
    --preview-window right \
    --preview "kubectl --kubeconfig=$KUBECONFIG -n $KNS --context $CONTEXT logs {1}" \
    --info=inline --header-lines=1 \
    --prompt "--kubeconfig=$KUBECONFIG -n $KNS --context $CONTEXT> " \
    --header $'╱ CTRL-O (open log in editor) ╱ CTRL-D (delete) ╱ CTRL-R (reload) ╱\n'
#    --bind "enter:execute:kubectl exec -it --kubeconfig=$KUBECONFIG -n $KNS {1} -- /bin/sh > /dev/tty"
}

